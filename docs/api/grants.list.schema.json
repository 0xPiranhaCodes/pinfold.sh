{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "grants.list",
  "description": "Lists unexpired 30-minute cross-pane grants. Needs hello version 2 and an identified terminal outside every pane; pane callers and callers without a terminal are refused.",
  "type": "object",
  "properties": {
    "params": {
      "description": "grants.list takes no arguments.",
      "type": ["object", "array", "null"]
    },
    "result": {
      "type": "object",
      "required": ["grants"],
      "additionalProperties": false,
      "properties": {
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "caller", "target", "action", "expires_ms"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "caller": { "type": "integer", "minimum": 0 },
              "target": { "type": "integer", "minimum": 0 },
              "action": { "enum": ["read", "send"] },
              "expires_ms": { "type": "integer", "minimum": 0, "maximum": 1800000 }
            }
          }
        }
      }
    }
  }
}
